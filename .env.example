# Copia este archivo a .env y ajusta los valores.

# Desarrollo / pruebas (por defecto): SQLite local
DATABASE_URL=sqlite:///./contratos.db

# Producción: PostgreSQL. Railway/Render inyectan esta variable automáticamente al
# conectar su base de datos; también acepta el formato "postgres://" que ellos usan.
# DATABASE_URL=postgresql+psycopg://usuario:clave@servidor:5432/contratos

# Autenticación (ver docs/05-despliegue-produccion.md). Desactivada por defecto.
# AUTH_REQUIRED=true
# SECRET_KEY=cambia-esto-por-una-cadena-larga-y-aleatoria
